---
import { kbCategories } from '../data/kb';

interface Props {
  currentSlug?: string;
  isSheet?: boolean;
}

const { currentSlug = '', isSheet = false } = Astro.props;

// Group categories into two columns as requested:
// Left: "НАЧАЛО РАБОТЫ", "ФУНКЦИИ КЛИЕНТА", "ПОДДЕРЖКА", "ССЫЛКИ"
// Right: "РАЗРАБОТКА ПЛАГИНОВ"
const leftGroupTitles = ["Начало работы", "Функции клиента", "Поддержка"];
const rightGroupTitles = ["Разработка плагинов"];

const leftCategories = kbCategories.filter(c => leftGroupTitles.includes(c.title));
const rightCategories = kbCategories.filter(c => rightGroupTitles.includes(c.title));

const linkItems = [
  { title: "ТГК (@MandaGram)", url: "https://t.me/MandaGram" },
  { title: "Беты (@MandaBeta)", url: "https://t.me/MandaBeta" },
  { title: "Чат разработчиков", url: "https://t.me/mandagram_dev" },
  { title: "GitHub", url: "https://github.com/GrapeS-T/MandaGram" }
];
---
<nav class="knav" aria-label="Разделы базы знаний">
  <a class="knav-home" href="/kb/">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="ic" aria-hidden="true" focusable="false"><path d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"></path></svg>
    <span>Все разделы</span>
  </a>

  <div class="knav-cols">
    <!-- Левая колонка: Начало работы, Функции клиента, Поддержка, Ссылки -->
    <div class="knav-col knav-col-left">
      {leftCategories.map(cat => (
        <div class="knav-g">
          <p class="knav-t">{cat.title}</p>
          <ul>
            {cat.articles.map(art => (
              <li>
                <a 
                  href={`/kb/${art.slug}/`} 
                  class={art.slug === currentSlug ? 'is-current' : ''}
                  aria-current={art.slug === currentSlug ? 'page' : undefined}
                >
                  {art.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="knav-g">
        <p class="knav-t">Ссылки</p>
        <ul>
          {linkItems.map(l => (
            <li>
              <a href={l.url} target="_blank" rel="noopener">
                {l.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Правая колонка: Разработка плагинов -->
    <div class="knav-col knav-col-right">
      {rightCategories.map(cat => (
        <div class="knav-g">
          <p class="knav-t">{cat.title}</p>
          <ul>
            {cat.articles.map(art => (
              <li>
                <a 
                  href={`/kb/${art.slug}/`} 
                  class={art.slug === currentSlug ? 'is-current' : ''}
                  aria-current={art.slug === currentSlug ? 'page' : undefined}
                >
                  {art.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</nav>
