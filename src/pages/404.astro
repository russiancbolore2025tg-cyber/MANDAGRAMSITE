---
import Base from '../layouts/Base.astro';
import KbSearch from '../components/KbSearch.astro';
---
<Base title="Страница не найдена — MandaGram" description="Запрошенная страница не существует или была перемещена." langRedirect={false}>
  <main id="main" class="nf">
    <div class="glows" aria-hidden="true">
      <span class="glow glow--p g1" style="top:10%;left:20%;width:800px;height:500px"></span>
      <span class="glow glow--t g4" style="bottom:10%;right:20%;width:600px;height:400px"></span>
    </div>
    <div class="nf-in">
      <div class="nf-code">404</div>
      <h1>Страница не найдена</h1>
      <p>Возможно, статья была переименована или перемещена. Воспользуйтесь поиском по документации и API ниже.</p>
      <div class="cta">
        <a class="btn btn--primary st" href="/">На главную</a>
        <a class="btn btn--tonal st" href="/kb/">База знаний</a>
      </div>
      <div class="kbs kbs--sm" style="text-align:left;width:min(480px,100%)">
        <KbSearch size="sm" idPrefix="kbs-404" />
      </div>
    </div>
  </main>
</Base>
