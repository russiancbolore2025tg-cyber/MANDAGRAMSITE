---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Wave from '../components/Wave.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'ru' | 'en';
  canonical?: string;
  langRedirect?: boolean;
  enPath?: string;
  activeNav?: string;
  isHome?: boolean;
  jsonLd?: object[];
}

const {
  title = 'MandaGram — нативный Telegram клиент на ПК с плагинами и Material 3 Expressive',
  description = 'MandaGram — быстрый Telegram-клиент для Windows и Linux. Нативные C ABI плагины на C++, Rust, Zig и D, горячая перезагрузка без перезапуска, темы ExteraMonet, защита Watchdog и медиаплеер VLC.',
  lang = 'ru',
  canonical = 'https://mandagram.app/',
  langRedirect = true,
  enPath = '/en/',
  activeNav = '',
  isHome = false,
  jsonLd = []
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href="https://mandagram.app/" />
    <link rel="alternate" hreflang="en" href="https://mandagram.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://mandagram.app/" />
    <meta name="theme-color" content="#151210" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png?v=3" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon.png?v=3" type="image/png" sizes="192x192" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="preload" href="/fonts/gs-cyrillic.woff2" as="font" type="font/woff2" crossorigin="" />
    <link rel="preload" href="/fonts/gs-latin.woff2" as="font" type="font/woff2" crossorigin="" />

    <!-- Theme & Locale Pre-initialization -->
    <script is:inline define:vars={{ langRedirect, enPath }}>
      (function () {
        try {
          var d = document.documentElement;
          if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("rv");
          var t = localStorage.getItem("mandagram-theme") || localStorage.getItem("ttu-theme");
          if (t === "light" || t === "dark") d.dataset.theme = t;
          if (t === "light") document.querySelector('meta[name="theme-color"]').content = "#FFF8F6";
          if (langRedirect && localStorage.getItem("mandagram-lang") === "en" && !location.search.includes("lang=ru")) location.replace(enPath + location.hash);
        } catch (e) {}
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} activeNav={activeNav} isHome={isHome} />
    
    <slot />

    <Wave />
    <Footer lang={lang} />

    <!-- Base Client Interactions Script -->
