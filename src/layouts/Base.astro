    <!-- Hero Morph Script -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        let morphs = document.querySelectorAll("[data-hero-morph]");
        morphs.forEach(m => {
          let t = null;
          m.addEventListener("mouseenter", () => {
            t = setTimeout(() => { m.classList.add("is-swaga"); }, 434);
          });
          m.addEventListener("mouseleave", () => {
            clearTimeout(t);
            m.classList.remove("is-swaga");
          });
          m.addEventListener("touchstart", () => {
            t = setTimeout(() => { m.classList.toggle("is-swaga"); }, 434);
          }, { passive: true });
        });
      });
    </script>
  </body>
</html>
